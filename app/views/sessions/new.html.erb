<div class="auth-page">
  <div class="auth-card">


 <div class="auth-header">
  <h1>Entrar</h1>
  <p>Acesse sua conta para continuar.</p>
</div>

<% if flash[:alert] %>
  <div class="auth-message auth-message-error">
    <%= flash[:alert] %>
  </div>
<% end %>

<% if flash[:notice] %>
  <div class="auth-message auth-message-success">
    <%= flash[:notice] %>
  </div>
<% end %>

<%= form_with url: session_path, class: "auth-form" do |form| %>

  <div class="form-group">
    <%= form.label :email_address, "E-mail" %>
    <%= form.email_field :email_address,
                        required: true,
                        autofocus: true,
                        autocomplete: "username",
                        placeholder: "Digite seu e-mail",
                        value: params[:email_address] %>
  </div>

  <div class="form-group">
    <%= form.label :password, "Senha" %>
    <%= form.password_field :password,
                           required: true,
                           autocomplete: "current-password",
                           placeholder: "Digite sua senha",
                           maxlength: 72 %>
  </div>

  <%= form.submit "Entrar", class: "button auth-submit" %>

<% end %>

 <div class="auth-footer">
  <%= link_to "Esqueci minha senha", new_password_path %>
  </div>


 </div>
</div>
