<div class="page-header">
  <h1><%= @category.name %></h1>
</div>

<div class="card" style="padding: 24px;">
  <p>
    <strong>Nome:</strong>
    <%= @category.name %>
  </p>

  <p>
    <strong>Categoria criada em:</strong>
    <%= @category.created_at.strftime("%d/%m/%Y") %>
  </p>
</div>

<br>

<%= link_to "Voltar", categories_path, class: "button button-secondary" %>
<%= link_to "Editar", edit_category_path(@category), class: "button" %>