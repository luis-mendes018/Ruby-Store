<div data-controller="modal">

  <div class="page-header">
   <div>
     <h1>Categorias</h1>
     <p class="record-count">
       <%= @pagy.count %> categorias cadastradas
     </p>
   </div>

   <%= link_to "Nova categoria", new_category_path, class: "button" %>
  </div>

  <div class="search-container">
    <%= form_with url: categories_path, method: :get do |form| %>
      <%= form.text_field :name,
                          value: params[:name],
                          placeholder: "Buscar categoria..." %>

      <%= form.submit "Buscar", class: "button" %>

      <% if params[:name].present? %>
        <%= link_to "Limpar", categories_path, class: "button button-secondary" %>
      <% end %>
    <% end %>
  </div>

  <div class="card">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>Ações</th>
        </tr>
      </thead>

      <tbody>
        <% @categories.each do |category| %>
          <tr>
            <td><%= category.name %></td>

            <td>
              <div class="actions">
                <%= link_to "Visualizar",
                            category_path(category),
                            class: "button button-small" %>

                <%= link_to "Editar",
                            edit_category_path(category),
                            class: "button button-small button-secondary" %>

                <button type="button"
                        class="button button-small button-danger"
                        data-action="click->modal#open"
                        data-delete-url="<%= category_path(category) %>">
                  Excluir
                </button>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== @pagy.series_nav %>

  <dialog data-modal-target="dialog">
    <h2>Excluir categoria?</h2>

    <p>
      Todos os produtos relacionados a esta categoria também serão excluídos.
      Essa ação não pode ser desfeita.
    </p>

    <div class="actions">
      <button type="button"
              class="button button-secondary"
              data-action="click->modal#close">
        Cancelar
      </button>

      <a href="#"
         class="button button-danger"
         data-modal-target="deleteLink"
         data-turbo-method="delete">
        Excluir
      </a>
    </div>
  </dialog>

</div>